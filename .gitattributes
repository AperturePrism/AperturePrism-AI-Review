# 强制 LF 换行并规范文本/二进制识别，避免跨平台 CRLF 混入（Windows/SMB 环境尤甚）。

# 默认：文本自动规范化换行为 LF
* text=auto eol=lf

# 源码与脚本强制 LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.css text eol=lf
*.html text eol=lf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.tgz binary
*.tar.gz binary
*.b64 binary

# 不参与 diff 的生成物
*.lock -diff
