NODE_ENV=development
HOST=0.0.0.0
PORT=30001
DATABASE_URL=postgresql://apertureprism:apertureprism@127.0.0.1:5432/apertureprism
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=1000
# Optional bearer token guarding the WebUI API routes (/tasks, /results, /providers, /events).
# Leave unset to disable auth (open dev/intranet mode).
# WEBUI_API_TOKEN=
# GitHub OAuth (enables GitHub login for the WebUI; optional).
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# OAuth callback that GitHub must redirect back to. Set this when the app is
# behind a reverse proxy / tunnel that rewrites Host or terminates TLS (e.g.
# https://review.example.com/auth/callback); must match a registered Callback URL.
# Leave unset to derive it from the incoming request (direct/localhost).
# OAUTH_REDIRECT_URI=
# GITHUB_WEBHOOK_SECRET=set-a-random-secret-and-keep-it-out-of-git
# GitHub App (mints installation tokens for API reads and comment publishing)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=C:\path\to\app-private-key.pem
# Defaults to the public GitHub API; set for GitHub Enterprise.
# GITHUB_API_BASE_URL=https://api.github.com
# Map model provider names to OpenAI-compatible base URLs for the worker:
#  (base URL must include the /v1 path; adapter appends /chat/completions)
# Primary/backup HA: list the primary provider first; the router falls back
#  to the next provider when the primary is unreachable/timing out.
# Example (replace with your own OpenAI-compatible gateway(s)):
MODEL_PROVIDER_BASE_URLS={"my-gateway":"https://gateway.example.com/v1"}
# Role policies in model_role_policies choose which providers they use; to
#  enable failover, each policy's `candidates` should list both providers.
# Default model the setup wizard pre-fills when seeding role policies. Set it
#  to whatever your gateway actually serves (no vendor model is assumed).
# DEFAULT_LLM_MODEL=gpt-4o-mini
# Embedding model: configured separately from the review model (own base + key).
# EMBEDDING_BASE_URL=https://gateway.example.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# The API key is NOT set here. The worker decrypts it from provider_accounts
# using CREDENTIAL_MASTER_KEY below; generate one and keep it out of git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_MASTER_KEY=
# Index worker interval in ms (default 600000 = 10 min).
# INDEX_INTERVAL_MS=600000
# Scan worker wake-up interval in ms (default 60000 = 1 min; per-repo scan
# frequency is configured per repository in the WebUI「仓库扫描」page).
# SCAN_INTERVAL_MS=60000
# NTQQ bot gateways per protocol (onebot11 | satori | milky):
# QQ_BOT_PROTOCOLS={"onebot11":{"baseUrl":"http://127.0.0.1:3000","accessToken":"...","gatewayUrl":"ws://127.0.0.1:3001"}}
# Official QQ open-platform bot (api-v2). AppSecret is used to fetch the
# access token; it stays in env, never in the repo.
# QQ_OFFICIAL_APP_ID=
# QQ_OFFICIAL_APP_SECRET=
# Defaults to wss://api.sgroup.qq.com/websocket; override for sandbox/enterprise.
# QQ_OFFICIAL_GATEWAY_URL=
# Intents bitmask (default 1<<25 enables C2C + GROUP_AT message events).
# QQ_OFFICIAL_INTENTS=33554432
# Alert webhook URL: POST JSON on alert triggered/resolved (Feishu/DingTalk/custom).
# Overridable per-instance via the「系统配置 → 全局运维」page.
# ALERT_WEBHOOK_URL=https://example.com/hooks/alert
# API base URL the bot calls to trigger tasks (default http://api:3300, the
# in-compose service name; override when qq-bot runs outside the compose net).
# QQ_BOT_API_BASE_URL=http://api:3300
# 审查工作台的持久目录；源码安装不设置时使用 ~/.apertureprism/workbench。
# API 与 analysis-worker 必须指向同一绝对目录。
# WORKBENCH_DATA_DIRECTORY=/var/lib/apertureprism/workbench
# 自动化规则、运行、审批和报告的持久目录；API 与 worker 需一致。
# AUTOMATION_DATA_DIRECTORY=/var/lib/apertureprism/automation
# 公平领取策略需要所有 worker 一致使用；未设置时沿用原队列顺序。
# TASK_QUEUE_POLICY_JSON={"agingIntervalMs":60000,"maxActivePerRepository":2,"maxActiveTotal":8,"roundRobin":true}
# TASK_RETRY_POLICY_JSON={"baseDelayMs":1000,"maxDelayMs":300000,"jitterRatio":0.2}
