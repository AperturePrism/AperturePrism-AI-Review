# EditorConfig: https://editorconfig.org
# 统一不同编辑器/IDE 的缩进、换行与编码，避免混合空白字符污染 diff。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{json,jsonc}]
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2
